params {
    input  = "${projectDir}/assets/samplesheet.csv"
    outdir = "results"

    // Reference data (set per run)
    fasta          = null
    gtf            = null
    index          = null
    transcriptome  = null
}

process {
    executor      = 'local'
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = 4
        memory = 12.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = 16
        memory = 32.GB
        time   = 24.h
    }
}

profiles {
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    conda       { conda.enabled = true }
    test        { includeConfig 'conf/test.config' }
    hpc         { includeConfig 'conf/base.config' }
}

manifest {
    name            = 'bioinformatics-pipeline-template'
    version         = '0.1.0'
    author          = 'G 08 Anurag Bhushan'
    description     = 'Reproducible RNA-seq workflow template (FASTQC, fastp, STAR, salmon, MultiQC)'
    nextflowVersion = '!>=23.04.0'
}