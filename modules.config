process {
    withName: FASTQC {
        publishDir = [ path: "${params.outdir}/fastqc", mode: 'copy' ]
    }
    withName: FASTP_TRIM {
        publishDir = [ path: "${params.outdir}/fastp", mode: 'copy' ]
    }
    withName: STAR_ALIGN {
        publishDir = [ path: "${params.outdir}/star", mode: 'copy' ]
    }
    withName: SALMON_QUANT {
        publishDir = [ path: "${params.outdir}/salmon", mode: 'copy' ]
    }
}