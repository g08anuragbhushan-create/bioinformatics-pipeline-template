params {
    input  = "${projectDir}/assets/samplesheet.csv"
    outdir = "results_test"
    index         = "${projectDir}/assets/test/reference/star_index"
    transcriptome = "${projectDir}/assets/test/reference/salmon_index"
}

process {
    withName: FASTQC       { cpus = 1; memory = 2.GB }
    withName: FASTP_TRIM   { cpus = 1; memory = 2.GB }
    withName: STAR_ALIGN   { cpus = 2; memory = 8.GB }
    withName: SALMON_QUANT { cpus = 2; memory = 4.GB }
}

executor { queueSize = 1 }